{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-atlas.invalid/schemas/atlas/1.0.0",
  "title": "Memory Atlas private project snapshot 1.0.0",
  "description": "Contract only. Cross-object and policy invariants are specified in DATA_MODEL.md. The .invalid URI is an identifier, not a network dependency.",
